<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- App Bar -->
    <LinearLayout
        android:id="@+id/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E2E"
        android:elevation="4dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Lyrics"
            android:textColor="#E0E0FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Synced lyrics on Android Auto"
            android:textColor="#8888AA"
            android:textSize="14sp"
            android:paddingTop="4dp" />
    </LinearLayout>

    <!-- Permission Status -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btn_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Grant Notification Access"
        android:textAllCaps="false"
        android:visibility="gone" />

    <!-- Track Info + Album Art + Source -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/iv_album_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_album_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#BB86FC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#AAAACC"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_source_pill"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Settings toggle row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btn_manual_search"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="⌕ Manual Search"
            android:textSize="11sp"
            android:textColor="#CCCCDD"
            android:backgroundTint="#2A2A3E"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btn_performance_mode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="⛶ Fullscreen Lyrics"
            android:textSize="11sp"
            android:textColor="#CCCCDD"
            android:backgroundTint="#2A2A3E"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            style="?attr/materialButtonOutlinedStyle" />

        <ImageButton
            android:id="@+id/btn_settings_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Text settings"
            android:scaleType="centerInside"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Font settings panel (collapsed by default) -->
    <LinearLayout
        android:id="@+id/layout_font_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2A"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Phone UI section title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone UI"
            android:textColor="#8888AA"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Font size row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textColor="#8888AA"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_font_size"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Changes lyric text size on the Phone UI only." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_font_size_minus"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:text="A−"
                android:textSize="13sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textAllCaps="false"
                style="?attr/materialButtonOutlinedStyle" />

            <TextView
                android:id="@+id/tv_font_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="16 sp"
                android:textColor="#CCCCDD"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="48dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_font_size_plus"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:text="A+"
                android:textSize="13sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:textAllCaps="false"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- Font family row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font"
                android:textColor="#8888AA"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_font_family"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Changes the lyric font on the Phone UI only." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_font_sans"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Sans"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#3A3A5E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_font_serif"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Serif"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_font_mono"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Mono"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_font_cursive"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Cursive"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="6dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- Android Auto section divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lyrics"
            android:textColor="#8888AA"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- AA Karaoke toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karaoke Mode"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_aa_karaoke"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Word-by-word highlighting on the phone, fullscreen, and Android Auto lyrics when word timing is available." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_aa_karaoke"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Translation toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Translate Lyrics"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_translation"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Enables lyric translation when lyrics are loaded. Translated lines appear in both Phone UI and Android Auto." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Sync section divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A3A"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Sync section title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sync"
            android:textColor="#8888AA"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <!-- Phone Sync offset row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Sync"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_phone_offset"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shifts lyric timing on the phone display. Fine-tune presets and Tap to Sync stay below the lyrics." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_delay_minus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="−50"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move phone lyrics 50 milliseconds earlier"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <TextView
                android:id="@+id/tv_delay"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="0ms"
                android:textColor="#CCCCDD"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="52dp"
                android:maxLines="1"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_delay_plus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="+50"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move phone lyrics 50 milliseconds later"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_phone_delay_reset"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:text="⟳"
                android:textSize="14sp"
                android:textColor="#D7A0A8"
                android:backgroundTint="#4A252C"
                android:contentDescription="Reset phone lyric timing offset"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                android:enabled="false"
                android:alpha="0.35"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- AA Sync offset row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AA Sync"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_aa_offset"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Adjusts Android Auto lyric timing only. This offset is shared with the Android Auto Sync tab and is applied in addition to Phone Sync." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_aa_delay_minus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="−50"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move Android Auto lyrics 50 milliseconds earlier"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <TextView
                android:id="@+id/tv_aa_delay"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="0ms"
                android:textColor="#CCCCDD"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="52dp"
                android:maxLines="1"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_aa_delay_plus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="+50"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move Android Auto lyrics 50 milliseconds later"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_aa_delay_reset"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:text="⟳"
                android:textSize="14sp"
                android:textColor="#D7A0A8"
                android:backgroundTint="#4A252C"
                android:contentDescription="Reset Android Auto lyric timing offset"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                android:enabled="false"
                android:alpha="0.35"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- Karaoke edge calibration row: per-head-unit calibration, so it
             only exists while a head unit is connected. -->
        <LinearLayout
            android:id="@+id/row_karaoke_edge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karaoke edge"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <com.autolyrics.ui.SettingInfoView
                android:id="@+id/info_karaoke_edge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:text="ⓘ"
                android:textColor="#777792"
                android:textSize="12sp"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Moves the right edge of the Android Auto Karaoke board by one character per tap. Watch the head unit while adjusting; the board column auto-sizes per car and this nudges it." />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_karaoke_edge_minus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="◀"
                android:textSize="12sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move the Android Auto Karaoke board right edge one character left"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <TextView
                android:id="@+id/tv_karaoke_edge"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="+0"
                android:textColor="#CCCCDD"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_karaoke_edge_plus"
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:text="▶"
                android:textSize="12sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:contentDescription="Move the Android Auto Karaoke board right edge one character right"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_karaoke_edge_reset"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:text="⟳"
                android:textSize="14sp"
                android:textColor="#D7A0A8"
                android:backgroundTint="#4A252C"
                android:contentDescription="Reset the Android Auto Karaoke board edge nudge"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:padding="0dp"
                android:enabled="false"
                android:alpha="0.35"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A3A"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Lyrics -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="#CCCCDD"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal"
                android:text="Play a song to see lyrics here.\n\nLyrics will also appear on Android Auto." />
        </ScrollView>

        <Button
            android:id="@+id/btn_jump_to_current"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="↓ Jump to Current"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            style="?attr/materialButtonOutlinedStyle" />
    </FrameLayout>

    <!-- Phone Sync Controls -->
    <LinearLayout
        android:id="@+id/layout_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A2A"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Fine adjustment row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_quick_minus_1s"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="−1s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_quick_minus_half"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="−0.5s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_quick_minus_tenth"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="−0.1s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_delay_reset"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="⟳ Reset"
                android:textSize="9sp"
                android:textColor="#D7A0A8"
                android:backgroundTint="#4A252C"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:enabled="false"
                android:alpha="0.35"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_quick_plus_tenth"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="+0.1s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="4dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_quick_plus_half"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="+0.5s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />

            <Button
                android:id="@+id/btn_quick_plus_1s"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="+1s"
                android:textSize="10sp"
                android:textColor="#AAAACC"
                android:backgroundTint="#222233"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="3dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- Tap to Sync row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/btn_tap_sync"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Tap to Sync"
                android:textSize="11sp"
                android:textColor="#CCCCDD"
                android:backgroundTint="#2A2A3E"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <!-- Sync status (full-width below Tap to Sync for readability) -->
        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:textColor="#CCCCDD"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
